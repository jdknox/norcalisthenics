<mujoco model="v43_clean_dynamics">
  <!--
    Long board as its OWN free body (no hinge), lying on the floor. Its head end butts against a fixed
    stop block on the floor (a wall works too). A foot plate on the board's foot end, 5 mm past the
    free foot: the straight free leg is the strut that stops the trainee sliding toward the feet.
    Trainee (82 kg, planar: slide x/z + pitch) is held by contact (mu = 0.6) and the thigh strap only.
    Board: 3.0 m, 7.2 kg + 1 kg plate, head end 2 m past the hip, foot end 1 m past the hip.
    Heel strap to an anchor 1.0 m headward of the heel, 2.0 m high, just taut with the knee straight.

    Controls:
      knee_target          0..2.4 rad  knee flexion. Drag slowly.
      hip_target           leave at 0 (weak, kp 20: the hip is effectively free)
      thigh_strap_slack    0 = snug, 0.30 = off   board (toward the feet) -> thigh cuff
      anchor_forward / anchor_down / strap_shorten  as v39 (winch -3..3)

    v43: physics ropes are invisible straight tendons (no sag nodes: those caused the torque chatter).
    The ropes you see are decorative twins (soft deadband springs through 2 g nodes): they hang when the
    real rope is slack and straighten when it is taut; their pull on the body is a few newtons.
    Sliders are filtered (knee 0.2 s, anchor / winch / thigh strap 0.5 s): jumps become ramps.

    Sensor: knee_torque only. cutoff = 400, so the plot's 1.0 = 400 Nm.
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81" noslip_iterations="20"/>
  <default>
    <geom friction="0.6 0.005 0.0001" rgba="0.75 0.75 0.72 1" contype="2" conaffinity="0"/>
    <joint damping="5" armature="0.05"/>
  </default>
  <worldbody>
    <light pos="0 -3 4" dir="0 1 -1"/>
    <camera name="side" pos="-0.6 -6.0 1.3" xyaxes="1 0 0 0 0 1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.35 0.3 0.3 1" contype="1" conaffinity="1" friction="0.6 0.005 0.0001"/>
    <geom name="head_stop" type="box" pos="-2.0505 0 0.05" size="0.05 0.25 0.05" contype="1" conaffinity="1" rgba="0.5 0.3 0.2 1"/>
    <body name="anchor_rig" pos="-0.6990 0 2.000">
      <joint name="anchor_forward" type="slide" axis="1 0 0" range="-2 4" damping="0" armature="1000"/>
      <joint name="anchor_down" type="slide" axis="0 0 -1" range="-2 1" damping="0" armature="1000"/>
      <geom type="box" size="0.05 0.05 0.05" mass="1" contype="0" conaffinity="0" rgba="0.9 0.3 0.3 1"/>
      <site name="anchor" size="0.04" rgba="0.9 0.9 0.9 1"/>
      <body name="strap_winch" pos="0 0 3.10">
        <joint name="strap_shorten" type="slide" axis="0 0 1" range="-3.00 3.00" damping="0" armature="1000"/>
        <geom type="box" size="0.02 0.02 0.02" mass="0.2" contype="0" conaffinity="0" rgba="0 0 0 0"/>
        <site name="strap_winch" size="0.01" rgba="0 0 0 0"/>
      </body>
    </body>

    <body name="board" pos="0 0 0.001">
      <joint name="board_x" type="slide" axis="1 0 0" damping="2" armature="0"/>
      <joint name="board_z" type="slide" axis="0 0 1" damping="2" armature="0"/>
      <joint name="board_tilt" type="hinge" axis="0 -1 0" pos="-2.00 0 0" damping="2" armature="0"/>
      <geom name="board" type="box" pos="-0.500 0 0.015" size="1.500 0.20 0.015" mass="7.2" contype="1" conaffinity="3" friction="0.6 0.005 0.0001" rgba="0.8 0.75 0.6 1"/>
      <geom name="foot_plate" type="box" pos="0.960 0 0.15" size="0.015 0.20 0.12" mass="1.0" contype="1" conaffinity="3" friction="0.6 0.005 0.0001" rgba="0.8 0.75 0.6 1"/>
      <site name="thigh_strap_board" pos="0.550 0 0.030" size="0.022" rgba="0.2 0.45 0.8 1"/>
      <body name="thigh_strap_winch" pos="0.550 0 -0.370">
        <joint name="thigh_strap_slack" type="slide" axis="0 0 1" range="0 0.32" damping="0" armature="1000"/>
        <geom type="box" size="0.01 0.01 0.01" mass="0.05" contype="0" conaffinity="0" rgba="0 0 0 0"/>
        <site name="thigh_strap_winch" size="0.005" rgba="0 0 0 0"/>
      </body>
    </body>

    <body name="trainee" pos="0 0 0.002">
      <joint name="root_x" type="slide" axis="1 0 0" damping="1" armature="0"/>
      <joint name="root_z" type="slide" axis="0 0 1" damping="1" armature="0"/>
      <joint name="root_pitch" type="hinge" axis="0 -1 0" pos="0 0 0.13" damping="1" armature="0"/>
      <geom name="pelvis" type="sphere" pos="0 0 0.13" size="0.10" mass="9"/>
      <geom name="torso" type="capsule" fromto="-0.10 0 0.14 -0.52 0 0.14" size="0.11" mass="36"/>
      <geom name="head" type="sphere" pos="-0.66 0 0.14" size="0.10" mass="5"/>
      <geom name="arms" type="capsule" fromto="-0.48 0 0.10 -0.05 0 0.10" size="0.04" mass="7"/>
      <geom name="free_leg" type="capsule" fromto="0.10 0 0.10 0.88 0 0.10" size="0.06" mass="12" rgba="0.6 0.6 0.58 1"/>
      <site name="hips" pos="0 0 0.13" size="0.02"/>
      <body name="thigh" pos="0 0 0.13" euler="0 -70.000 0">
        <joint name="hip" type="hinge" axis="0 -1 0" range="-100 60"/>
        <geom name="thigh" type="capsule" fromto="0.08 0 0 0.45 0 0" size="0.07" mass="9"/>
        <geom name="cuff" type="cylinder" pos="0.360 0 0" euler="0 90 0" size="0.085 0.04" mass="0.1" rgba="0.2 0.45 0.8 0.8"/>
        <site name="cuff" pos="0.360 0 0" size="0.02" rgba="0.2 0.45 0.8 1"/>
        <body name="shin" pos="0.45 0 0">
          <joint name="knee" type="hinge" axis="0 1 0" range="-5 140"/>
          <geom name="shin" type="capsule" fromto="0.04 0 0 0.43 0 0" size="0.045" mass="4"/>
          <site name="heel" pos="0.43 0 0" size="0.03" rgba="0.8 0.5 0.1 1"/>
        </body>
      </body>
    </body>
    <body name="vis_strap_0" pos="-0.5879 0 1.8843">
      <joint name="vis_strap_0_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_0_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_0" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_strap_1" pos="-0.4768 0 1.7687">
      <joint name="vis_strap_1_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_1_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_1" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_strap_2" pos="-0.3657 0 1.6530">
      <joint name="vis_strap_2_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_2_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_2" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_strap_3" pos="-0.2546 0 1.5373">
      <joint name="vis_strap_3_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_3_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_3" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_strap_4" pos="-0.1435 0 1.4216">
      <joint name="vis_strap_4_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_4_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_4" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_strap_5" pos="-0.0323 0 1.3060">
      <joint name="vis_strap_5_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_5_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_5" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_strap_6" pos="0.0788 0 1.1903">
      <joint name="vis_strap_6_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_6_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_6" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_strap_7" pos="0.1899 0 1.0746">
      <joint name="vis_strap_7_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_strap_7_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_strap_7" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_thigh_strap_0" pos="0.4789 0 0.1042">
      <joint name="vis_thigh_strap_0_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_thigh_strap_0_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_thigh_strap_0" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_thigh_strap_1" pos="0.4077 0 0.1774">
      <joint name="vis_thigh_strap_1_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_thigh_strap_1_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_thigh_strap_1" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_thigh_strap_2" pos="0.3366 0 0.2506">
      <joint name="vis_thigh_strap_2_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_thigh_strap_2_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_thigh_strap_2" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_thigh_strap_3" pos="0.2654 0 0.3239">
      <joint name="vis_thigh_strap_3_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_thigh_strap_3_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_thigh_strap_3" size="0.003" rgba="0 0 0 0"/>
    </body>
    <body name="vis_thigh_strap_4" pos="0.1943 0 0.3971">
      <joint name="vis_thigh_strap_4_x" type="slide" axis="1 0 0" damping="0.05" armature="0"/>
      <joint name="vis_thigh_strap_4_z" type="slide" axis="0 0 1" damping="0.05" armature="0"/>
      <geom type="sphere" size="0.005" mass="0.002" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="vis_thigh_strap_4" size="0.003" rgba="0 0 0 0"/>
    </body>
  </worldbody>

  <tendon>
    <spatial name="strap" width="0.008" rgba="0 0 0 0" solreflimit="0.002 1" solimplimit="0.99 0.999 0.001" range="0 4.5445">
      <site site="strap_winch"/><site site="anchor"/><site site="heel"/>
    </spatial>
    <spatial name="thigh_strap" width="0.012" rgba="0 0 0 0" solreflimit="0.002 1" solimplimit="0.99 0.999 0.001" range="0 1.0125">
      <site site="thigh_strap_winch"/><site site="thigh_strap_board"/><site site="cuff"/>
    </spatial>
    <spatial name="strap_visual" width="0.008" rgba="0.8 0.5 0.1 1" limited="false" stiffness="100.0" springlength="0 4.5445">
      <site site="strap_winch"/>
      <site site="anchor"/>
      <site site="vis_strap_0"/>
      <site site="vis_strap_1"/>
      <site site="vis_strap_2"/>
      <site site="vis_strap_3"/>
      <site site="vis_strap_4"/>
      <site site="vis_strap_5"/>
      <site site="vis_strap_6"/>
      <site site="vis_strap_7"/>
      <site site="heel"/>
    </spatial>
    <spatial name="thigh_strap_visual" width="0.012" rgba="0.2 0.45 0.8 1" limited="false" stiffness="100.0" springlength="0 1.0125">
      <site site="thigh_strap_winch"/>
      <site site="thigh_strap_board"/>
      <site site="vis_thigh_strap_0"/>
      <site site="vis_thigh_strap_1"/>
      <site site="vis_thigh_strap_2"/>
      <site site="vis_thigh_strap_3"/>
      <site site="vis_thigh_strap_4"/>
      <site site="cuff"/>
    </spatial>
  </tendon>

  <actuator>
    <position name="knee_target" timeconst="0.2" joint="knee" kp="4000" kv="150" ctrlrange="0 2.4" forcerange="-1000 1000"/>
    <position name="hip_target" joint="hip" kp="20" kv="10" ctrlrange="-1 1" forcerange="-300 300"/>
    <position name="thigh_strap_slack" timeconst="0.5" joint="thigh_strap_slack" kp="10000000" kv="200000" ctrlrange="0 0.30"/>
    <position name="anchor_forward" timeconst="0.5" joint="anchor_forward" kp="10000000" kv="200000" ctrlrange="-2 4"/>
    <position name="anchor_down" timeconst="0.5" joint="anchor_down" kp="10000000" kv="200000" ctrlrange="-2 1"/>
    <position name="strap_shorten" timeconst="0.5" joint="strap_shorten" kp="10000000" kv="200000" ctrlrange="-3.00 3.00"/>
  </actuator>

  <sensor>
    <actuatorfrc name="knee_torque" actuator="knee_target" cutoff="400"/>
  </sensor>
</mujoco>
