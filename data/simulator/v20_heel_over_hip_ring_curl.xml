<mujoco model="v21_heel_over_hip_ring_curl">
  <!--
    Heel-over-hip ring curl. Planar side view, ~82 kg, lying face up along x (head at -x).
    Working heel in a fixed-length ring strap from a ceiling anchor (4.0 m) directly
    above the hip. Knee bends the anatomical way: thigh drawn toward the chest past vertical
    (hip ~119 deg at the start), shin folding back over the hip. Upper back on the floor (the head is non-colliding). Knee flexion shortens the
    hip-to-heel distance, so the pelvis rises toward the ring.

    The strap pulls straight up through the hip, so the hip needs little torque. The knee
    lever is the knee's horizontal offset from that line (grows with knee flexion).

    QUASI-STATIC: knee is a POSITION servo (set the angle, read the torque). The working hip is
    nearly passive (weak servo), so you can see it needs almost nothing.

    Controls:
      knee_target      0..2.5 rad  working knee flexion, absolute (strap just taut at 60 deg = 1.05 rad;
                                   Load keyframe "start" first: it sets knee 1.05 and the free leg up.)
      hip_target      -0.5..2.2 rad working hip, relative to the start pose (very weak servo,
                                   effectively passive: leave it)
      free_hip_target -0.5..2.2 rad free leg: 0 = flat on floor, ~1.7 = held up
      assist_lift      0..1         help lifting the pelvis (free foot bridging or hands), x 600 N
      pelvis_load      0..1         plate on the hips (progression), x 400 N

    Sensors (Watch -> sensordata index):
      0 knee_torque (Nm, + = flexion = hamstrings)
      1 hip_torque (Nm)   2 strap_tension (N)   3 pelvis_lift (m)   4 upper_back_floor (N)
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.9 0.005 0.0001" rgba="0.75 0.75 0.72 1" contype="1" conaffinity="1"/>
    <joint damping="5" armature="0.05"/>
  </default>
  <worldbody>
    <light pos="0 -3 4" dir="0 1 -1"/>
    <camera name="side" pos="0.0 -4.5 1.2" xyaxes="1 0 0 0 0 1"/>
    <geom name="floor" type="plane" size="4 4 0.1" rgba="0.3 0.3 0.3 1"/>
    <site name="anchor" pos="0.0000 0 4.00" size="0.04" rgba="0.9 0.9 0.9 1"/>

    <body name="trunk" pos="0 0 0.110">
      <joint name="root_x" type="slide" axis="1 0 0" damping="1" armature="0"/>
      <joint name="root_z" type="slide" axis="0 0 1" damping="1" armature="0"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" damping="1" armature="0"/>
      <geom name="pelvis" type="sphere" size="0.10" mass="9"/>
      <geom name="torso" type="capsule" fromto="-0.10 0 0 -0.52 0 0" size="0.11" mass="36"/>
      <geom name="head" type="sphere" pos="-0.66 0 0.04" size="0.10" mass="5" contype="0" conaffinity="0"/>
      <geom name="arms" type="capsule" fromto="-0.48 0 -0.02 -0.05 0 -0.02" size="0.04" mass="7"/>
      <site name="pelvis_site" pos="0 0 0.10" size="0.02"/>
      <site name="shoulder_pad" type="box" pos="-0.45 0 -0.11" size="0.20 0.12 0.03" rgba="0 1 0 0.15"/>

      <body name="thigh" pos="0 0 0" euler="0 -119.248 0">
        <joint name="hip" type="hinge" axis="0 -1 0" range="-100 40"/>
        <geom name="thigh" type="capsule" fromto="0.08 0 0 0.45 0 0" size="0.07" mass="9"/>
        <body name="shin" pos="0.45 0 0" euler="0 60.000 0">
          <joint name="knee" type="hinge" axis="0 1 0" ref="60.0" range="0 145"/>
          <geom name="shin" type="capsule" fromto="0.04 0 0 0.43 0 0" size="0.045" mass="4"/>
          <site name="heel" pos="0.43 0 0" size="0.03" rgba="0.8 0.5 0.1 1"/>
        </body>
      </body>

      <body name="free_leg" pos="0 0 0">
        <joint name="free_hip" type="hinge" axis="0 -1 0" range="-30 130"/>
        <geom name="free_leg" type="capsule" fromto="0.10 0 0 0.80 0 0" size="0.06" mass="12" rgba="0.6 0.6 0.58 1"/>
        <geom name="free_foot" type="sphere" pos="0.88 0 0" size="0.05" mass="0.5" rgba="0.6 0.6 0.58 1"/>
      </body>
    </body>
    <body name="sag_strap_anchor_0" pos="0.0000 0 3.3744">
      <joint name="sag_strap_anchor_0_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_strap_anchor_0_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_strap_anchor_0" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_strap_anchor_1" pos="0.0000 0 2.7489">
      <joint name="sag_strap_anchor_1_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_strap_anchor_1_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_strap_anchor_1" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_strap_anchor_2" pos="0.0000 0 2.1233">
      <joint name="sag_strap_anchor_2_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_strap_anchor_2_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_strap_anchor_2" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_strap_anchor_3" pos="0.0000 0 1.4977">
      <joint name="sag_strap_anchor_3_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_strap_anchor_3_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_strap_anchor_3" size="0.004" rgba="0 0 0 0"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="trunk" body2="thigh"/>
    <exclude body1="trunk" body2="free_leg"/>
    <exclude body1="thigh" body2="free_leg"/>
    <exclude body1="shin" body2="free_leg"/>
  </contact>

  <tendon>
    <spatial name="strap" width="0.008" rgba="0.8 0.5 0.1 1" solreflimit="0.002 1" solimplimit="0.99 0.999 0.001" range="0 3.1278">
      <site site="anchor"/>
      <site site="sag_strap_anchor_0"/>
      <site site="sag_strap_anchor_1"/>
      <site site="sag_strap_anchor_2"/>
      <site site="sag_strap_anchor_3"/>
      <site site="heel"/>
    </spatial>
  </tendon>

  <actuator>
    <position name="knee_target" joint="knee" kp="4000" kv="150" ctrlrange="0 2.5" forcerange="-1000 1000"/>
    <position name="hip_target" joint="hip" kp="20" kv="10" ctrlrange="-0.5 2.2" forcerange="-300 300"/>
    <position name="free_hip_target" joint="free_hip" kp="2000" kv="100" ctrlrange="-0.5 2.2" forcerange="-600 600"/>
    <motor name="assist_lift" site="pelvis_site" gear="0 0 600 0 0 0" ctrlrange="0 1"/>
    <motor name="pelvis_load" site="pelvis_site" gear="0 0 -400 0 0 0" ctrlrange="0 1"/>
  </actuator>

  <keyframe>
    <key name="start" ctrl="1.047 0 1.75 0 0"/>
  </keyframe>

  <sensor>
    <actuatorfrc name="knee_torque" actuator="knee_target"/>
    <jointactuatorfrc name="hip_torque" joint="hip"/>
    <tendonlimitfrc name="strap_tension" tendon="strap"/>
    <jointpos name="pelvis_lift" joint="root_z"/>
    <touch name="upper_back_floor" site="shoulder_pad"/>
  </sensor>
</mujoco>
