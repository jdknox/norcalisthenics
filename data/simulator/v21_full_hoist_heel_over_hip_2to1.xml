<mujoco model="v22_full_hoist_heel_over_hip_2to1">
  <!--
    Full-weight heel-over-hip curl (2:1 at the heel (pulley on the ankle cuff: heel gets twice the harness load)). Planar, ~82 kg, lying face up along x.
    Working heel directly above the hip (knee drawn toward the chest, knee bent, anatomical
    flexion). One rope over ceiling pulleys: one pulley above the heel/hip, one above the chest
    harness tie-in (top of the upper chest). Curling the knee shortens hip-to-heel distance and
    hoists the whole body off the floor; the heel strand(s) run vertically through the hip.

    QUASI-STATIC: knee is a POSITION servo (set the angle, read the torque); hip is near-passive.

    Controls:
      knee_target      0..2.5 rad  knee flexion, absolute (rope just taut at 60 deg = 1.05 rad).
                                   Load keyframe "start" first (free leg flat forward, which lets you lift fully).
      hip_target       working hip, very weak servo (effectively passive): leave it
      free_hip_target  free leg: 0 = in line with the torso, ~1.7 = held up
      assist_lift      0..1  help lifting the pelvis (free foot / hands), x 600 N
      pelvis_load      0..1  plate on the hips, x 400 N

    Sensors (Watch -> sensordata index):
      0 knee_torque (Nm, + = flexion)   1 hip_torque (Nm)   2 rope_tension (N, per strand)
      3 pelvis_lift (m)   4 upper_back_floor (N, 0 = fully off the floor)
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.9 0.005 0.0001" rgba="0.75 0.75 0.72 1" contype="1" conaffinity="1"/>
    <joint damping="5" armature="0.05"/>
  </default>
  <worldbody>
    <light pos="0 -3 4" dir="0 1 -1"/>
    <camera name="side" pos="0.0 -4.5 1.2" xyaxes="1 0 0 0 0 1"/>
    <geom name="floor" type="plane" size="4 4 0.1" rgba="0.3 0.3 0.3 1"/>
    <site name="p_heel" pos="0.0000 0 4.00" size="0.04" rgba="0.9 0.9 0.9 1"/>
    <site name="p_harness" pos="-0.4500 0 4.00" size="0.04" rgba="0.9 0.9 0.9 1"/>
    <site name="rope_end" pos="0.0600 0 4.00" size="0.03" rgba="0.9 0.3 0.3 1"/>

    <body name="trunk" pos="0 0 0.110">
      <joint name="root_x" type="slide" axis="1 0 0" damping="1" armature="0"/>
      <joint name="root_z" type="slide" axis="0 0 1" damping="1" armature="0"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" damping="1" armature="0"/>
      <geom name="pelvis" type="sphere" size="0.10" mass="9"/>
      <geom name="torso" type="capsule" fromto="-0.10 0 0 -0.52 0 0" size="0.11" mass="36"/>
      <geom name="head" type="sphere" pos="-0.66 0 0.04" size="0.10" mass="5" contype="0" conaffinity="0"/>
      <geom name="arms" type="capsule" fromto="-0.48 0 -0.02 -0.05 0 -0.02" size="0.04" mass="7"/>
      <site name="pelvis_site" pos="0 0 0.10" size="0.02"/>
      <site name="harness" pos="-0.45 0 0.12" size="0.03" rgba="0.8 0.5 0.1 1"/>
      <site name="shoulder_pad" type="box" pos="-0.45 0 -0.11" size="0.20 0.12 0.03" rgba="0 1 0 0.15"/>

      <body name="thigh" pos="0 0 0" euler="0 -119.248 0">
        <joint name="hip" type="hinge" axis="0 -1 0" range="-100 40"/>
        <geom name="thigh" type="capsule" fromto="0.08 0 0 0.45 0 0" size="0.07" mass="9"/>
        <body name="shin" pos="0.45 0 0" euler="0 60.000 0">
          <joint name="knee" type="hinge" axis="0 1 0" ref="60.0" range="0 145"/>
          <geom name="shin" type="capsule" fromto="0.04 0 0 0.43 0 0" size="0.045" mass="4"/>
          <site name="heel" pos="0.43 0 0" size="0.03" rgba="0.8 0.5 0.1 1"/>
        </body>
      </body>

      <body name="free_leg" pos="0 0 0">
        <joint name="free_hip" type="hinge" axis="0 -1 0" range="-30 130"/>
        <geom name="free_leg" type="capsule" fromto="0.10 0 0 0.80 0 0" size="0.06" mass="12" rgba="0.6 0.6 0.58 1"/>
        <geom name="free_foot" type="sphere" pos="0.88 0 0" size="0.05" mass="0.5" rgba="0.6 0.6 0.58 1"/>
      </body>
    </body>
    <body name="sag_rope_rope_end_0" pos="0.0480 0 3.3744">
      <joint name="sag_rope_rope_end_0_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_rope_end_0_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_rope_end_0" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_rope_end_1" pos="0.0360 0 2.7489">
      <joint name="sag_rope_rope_end_1_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_rope_end_1_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_rope_end_1" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_rope_end_2" pos="0.0240 0 2.1233">
      <joint name="sag_rope_rope_end_2_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_rope_end_2_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_rope_end_2" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_rope_end_3" pos="0.0120 0 1.4977">
      <joint name="sag_rope_rope_end_3_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_rope_end_3_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_rope_end_3" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_heel_0" pos="0.0000 0 1.4977">
      <joint name="sag_rope_heel_0_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_heel_0_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_heel_0" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_heel_1" pos="0.0000 0 2.1233">
      <joint name="sag_rope_heel_1_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_heel_1_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_heel_1" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_heel_2" pos="0.0000 0 2.7489">
      <joint name="sag_rope_heel_2_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_heel_2_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_heel_2" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_heel_3" pos="0.0000 0 3.3744">
      <joint name="sag_rope_heel_3_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_heel_3_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_heel_3" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_p_harness_0" pos="-0.4500 0 3.2460">
      <joint name="sag_rope_p_harness_0_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_p_harness_0_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_p_harness_0" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_p_harness_1" pos="-0.4500 0 2.4920">
      <joint name="sag_rope_p_harness_1_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_p_harness_1_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_p_harness_1" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_p_harness_2" pos="-0.4500 0 1.7380">
      <joint name="sag_rope_p_harness_2_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_p_harness_2_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_p_harness_2" size="0.004" rgba="0 0 0 0"/>
    </body>
    <body name="sag_rope_p_harness_3" pos="-0.4500 0 0.9840">
      <joint name="sag_rope_p_harness_3_x" type="slide" axis="1 0 0" damping="20" armature="0.02"/>
      <joint name="sag_rope_p_harness_3_z" type="slide" axis="0 0 1" damping="20" armature="0.02"/>
      <geom type="sphere" size="0.006" mass="0.02" contype="0" conaffinity="0" rgba="0 0 0 0"/>
      <site name="sag_rope_p_harness_3" size="0.004" rgba="0 0 0 0"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="trunk" body2="thigh"/>
    <exclude body1="trunk" body2="free_leg"/>
    <exclude body1="thigh" body2="free_leg"/>
    <exclude body1="shin" body2="free_leg"/>
  </contact>

  <tendon>
    <spatial name="rope" width="0.008" rgba="0.8 0.5 0.1 1" solreflimit="0.002 1" solimplimit="0.99 0.999 0.001" range="0 10.4762">
      <site site="rope_end"/>
      <site site="sag_rope_rope_end_0"/>
      <site site="sag_rope_rope_end_1"/>
      <site site="sag_rope_rope_end_2"/>
      <site site="sag_rope_rope_end_3"/>
      <site site="heel"/>
      <site site="sag_rope_heel_0"/>
      <site site="sag_rope_heel_1"/>
      <site site="sag_rope_heel_2"/>
      <site site="sag_rope_heel_3"/>
      <site site="p_heel"/>
      <site site="p_harness"/>
      <site site="sag_rope_p_harness_0"/>
      <site site="sag_rope_p_harness_1"/>
      <site site="sag_rope_p_harness_2"/>
      <site site="sag_rope_p_harness_3"/>
      <site site="harness"/>
    </spatial>
  </tendon>

  <actuator>
    <position name="knee_target" joint="knee" kp="4000" kv="150" ctrlrange="0 2.5" forcerange="-1000 1000"/>
    <position name="hip_target" joint="hip" kp="20" kv="10" ctrlrange="-0.5 2.2" forcerange="-300 300"/>
    <position name="free_hip_target" joint="free_hip" kp="2000" kv="100" ctrlrange="-0.5 2.2" forcerange="-600 600"/>
    <motor name="assist_lift" site="pelvis_site" gear="0 0 600 0 0 0" ctrlrange="0 1"/>
    <motor name="pelvis_load" site="pelvis_site" gear="0 0 -400 0 0 0" ctrlrange="0 1"/>
  </actuator>

  <keyframe>
    <key name="start" ctrl="1.047 0 0 0 0"/>
  </keyframe>

  <sensor>
    <actuatorfrc name="knee_torque" actuator="knee_target"/>
    <jointactuatorfrc name="hip_torque" joint="hip"/>
    <tendonlimitfrc name="rope_tension" tendon="rope"/>
    <jointpos name="pelvis_lift" joint="root_z"/>
    <touch name="upper_back_floor" site="shoulder_pad"/>
  </sensor>
</mujoco>
