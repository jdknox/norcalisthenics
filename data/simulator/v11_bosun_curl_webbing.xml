<mujoco model="bosun_curl_webbing_v11">
  <!--
    Real bosun's chair: board under the thighs, WEBBING bridle (tension-only) from the board's
    rear and front edges up to an apex pulley 1.6 m above the hip. Both thighs strapped to the
    board. Rope: ceiling pulley -> apex pulley -> both heels. ~85 kg.
    Compare with v10, where the same bridle was modelled as rigid sticks.

    The apex is a free point held only by the two bridle legs (they go slack, never push).

    Controls:
      knee_target  0..2.0 rad  knee angle (0 = straight, + = flexion), position servo
      hip_target  -1.3..1.0 rad torso posture (0 = upright)

    Sensors (Watch -> sensordata index):
      0 knee_torque (Nm, both legs)   1 hip_torque (Nm)   2 rope_tension (N)
      3 bridle_rear (N)   4 bridle_front (N)   5 seat_pitch (rad)   6 seat_z (m)
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.8 0.005 0.0001" rgba="0.75 0.75 0.72 1" contype="1" conaffinity="1"/>
    <joint damping="5" armature="0.05"/>
  </default>
  <worldbody>
    <light pos="0 -3 3" dir="0 1 -1"/>
    <camera name="side" pos="0.3 -5.0 1.5" xyaxes="1 0 0 0 0 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.3 0.3 0.3 1"/>
    <site name="pulley" pos="0.1234 0 3.0" size="0.04" rgba="0.9 0.9 0.9 1"/>
    <body name="seat" pos="0 0 0.52">
      <joint name="root_x" type="slide" axis="1 0 0" damping="1" armature="0"/>
      <joint name="root_z" type="slide" axis="0 0 1" damping="1" armature="0"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" damping="1" armature="0"/>
      <geom name="board" type="box" pos="0.22 0 -0.09" size="0.24 0.20 0.02" mass="3" rgba="0.8 0.75 0.6 1"/>
      <geom name="pelvis" type="sphere" size="0.07" mass="10"/>
      <geom name="thighs" type="capsule" fromto="0 0 0 0.45 0 0" size="0.08" mass="20"/>
      <site name="strap_rear" pos="0.05 0 0.08" size="0.02" rgba="0.2 0.45 0.8 1"/>
      <site name="strap_front" pos="0.40 0 0.08" size="0.02" rgba="0.2 0.45 0.8 1"/>
      
      <body name="torso" pos="0 0 0">
        <joint name="hip" type="hinge" axis="0 1 0" range="-75 60"/>
        <geom name="trunk" type="capsule" fromto="0 0 0.10 0 0 0.53" size="0.11" mass="40"/>
        <geom name="head" type="sphere" pos="0 0 0.68" size="0.10" mass="6"/>
      </body>
      <body name="shins" pos="0.45 0 0">
        <joint name="knee" type="hinge" axis="0 1 0" range="-5 120"/>
        <geom name="shins" type="capsule" fromto="0 0 0 0.43 0 0" size="0.06" mass="9"/>
        <site name="heel" pos="0.43 0 0" size="0.035" rgba="0.8 0.5 0.1 1"/>
      </body>
    </body>
    <body name="apex" pos="0.1234 0 2.120">
      <joint name="apex_x" type="slide" axis="1 0 0" damping="2" armature="0"/>
      <joint name="apex_z" type="slide" axis="0 0 1" damping="2" armature="0"/>
      <geom type="sphere" size="0.03" mass="0.2" contype="0" conaffinity="0" rgba="0.9 0.9 0.9 1"/>
      <site name="hang" size="0.035" rgba="0.9 0.9 0.9 1"/>
    </body>
  </worldbody>
  <tendon>
    <spatial name="rope" width="0.008" rgba="0.8 0.5 0.1 1" range="0 2.6499">
      <site site="pulley"/><site site="hang"/><site site="heel"/>
    </spatial>
    <spatial name="leg_rear" width="0.01" rgba="0.15 0.15 0.15 1" range="0 1.5218">
      <site site="strap_rear"/><site site="hang"/>
    </spatial>
    <spatial name="leg_front" width="0.01" rgba="0.15 0.15 0.15 1" range="0 1.5450">
      <site site="strap_front"/><site site="hang"/>
    </spatial>
  </tendon>
  <actuator>
    <position name="knee_target" joint="knee" kp="4000" kv="120" ctrlrange="0 2.0" forcerange="-900 900"/>
    <position name="hip_target"  joint="hip"  kp="3000" kv="100" ctrlrange="-1.3 1.0" forcerange="-600 600"/>
  </actuator>
  <sensor>
    <actuatorfrc name="knee_torque" actuator="knee_target"/>
    <actuatorfrc name="hip_torque" actuator="hip_target"/>
    <tendonlimitfrc name="rope_tension" tendon="rope"/>
    <tendonlimitfrc name="bridle_rear" tendon="leg_rear"/>
    <tendonlimitfrc name="bridle_front" tendon="leg_front"/>
    <jointpos name="seat_pitch" joint="root_pitch"/>
    <jointpos name="seat_z" joint="root_z"/>
  </sensor>
</mujoco>
