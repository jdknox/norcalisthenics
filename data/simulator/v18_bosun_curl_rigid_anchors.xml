      <geom type="box" size="0.05 0.05 0.05" mass="10" contype="0" conaffinity="0" rgba="0.9 0.3 0.3 1"/>
      <site name="tether_anchor" size="0.04" rgba="0.9 0.3 0.3 1"/>
      <body name="winch" pos="0 0 0.20">
