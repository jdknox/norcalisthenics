<mujoco model="floor_chest_pulley_curl_v6">
  <!--
    Floor-seated chest-pulley curl. Planar side view. ~76 kg body.

    Start seated on the floor. Working thigh raised toward the chest (45 deg above horizontal,
    hip ~135 deg) and held there (thigh against chest, or a strap from the distal thigh around
    the upper back; modelled as rigid). Rope: ceiling anchor (pulley site, x = 0.120) straight
    down to a small pulley on the chest harness at the top of the sternum (harness site), then
    out to the heel. Only the ceiling strand acts on you from outside, so you hang level
    (~9 deg) as you rise. Rope tension = your hanging weight (1:1).

    QUASI-STATIC: knee is a POSITION servo. Set the angle, read the torque.

    Controls:
      knee_target  0..2.6 rad  knee angle (0 = straight, + = flexion)
      assist_push  0..1        hands pushing on the floor, x 800 N

    Sensors (Watch -> sensordata index):
      0 knee_torque (Nm, + = flexion = hamstrings)
      1 rope_tension (N)
      2 assist_force (N)
      3 unit_pitch (rad)
      4 unit_z (m, lift off the floor)

    Edit to explore: harness site height (higher = more load later in the range),
    thigh angle (regenerate), pulley x (keep it above the harness site).
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.8 0.005 0.0001" rgba="0.75 0.75 0.72 1" contype="1" conaffinity="1"/>
    <joint damping="5" armature="0.05"/>
  </default>
  <worldbody>
    <light pos="0 -3 3" dir="0 1 -1"/>
    <camera name="side" pos="0.3 -4.0 0.9" xyaxes="1 0 0 0 0 1"/>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.3 0.3 0.3 1" contype="3" conaffinity="3"/>
    
    <site name="pulley" pos="0.1200 0 2.5" size="0.04" rgba="0.8 0.5 0.1 1"/>
    <body name="unit" pos="0 0 0.10">
      <joint name="root_x" type="slide" axis="1 0 0" damping="1" armature="0"/>
      <joint name="root_z" type="slide" axis="0 0 1" damping="1" armature="0"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" damping="1" armature="0"/>
      <geom name="butt" type="sphere" size="0.10" mass="16"/>
      <geom name="trunk" type="capsule" fromto="0 0 0.12 0 0 0.55" size="0.11" mass="40" friction="0.05 0.005 0.0001"/>
      <geom name="head" type="sphere" pos="0 0 0.70" size="0.10" mass="6"/>
      <site name="harness" pos="0.120 0 0.700" size="0.03" rgba="0.9 0.9 0.9 1"/>
      <geom name="thigh" type="capsule" fromto="0 0 0 0.3182 0 0.3182" size="0.07" mass="10"/>
      <geom name="thigh_strap" type="capsule" fromto="0.2705 0 0.2705 -0.06 0 0.40" size="0.008" mass="0.1" contype="0" conaffinity="0" rgba="0.2 0.45 0.8 1"/>
      <body name="shin" pos="0.3182 0 0.3182" euler="0 -45.000 0">
        <joint name="knee" type="hinge" axis="0 1 0" range="-5 150"/>
        <geom name="shin" type="capsule" fromto="0 0 0 0.43 0 0" size="0.045" mass="4.5"/>
        <site name="heel" pos="0.43 0 0" size="0.03" rgba="0.8 0.5 0.1 1"/>
      </body>
      <body name="hands" pos="0.15 0 0.30">
        <joint name="hand_push" type="slide" axis="0 0 -1" range="-0.05 0.60" damping="20" armature="0"/>
        <geom name="arm" type="capsule" fromto="0 0 0 0 0 -0.30" size="0.03" mass="1" contype="0" conaffinity="0" rgba="0.6 0.6 0.58 1"/>
        <geom name="hand" type="sphere" pos="0 0 -0.30" size="0.04" mass="0.3" contype="2" conaffinity="2" rgba="0.6 0.6 0.58 1"/>
      </body>
    </body>
  </worldbody>
  <tendon>
    <spatial name="rope" width="0.008" rgba="0.8 0.5 0.1 1" range="0 2.2082">
      <site site="pulley"/>
      <site site="harness"/>
      <site site="heel"/>
    </spatial>
  </tendon>
  <actuator>
    <position name="knee_target" joint="knee" kp="3000" kv="100" ctrlrange="0 2.6" forcerange="-600 600"/>
    <motor name="assist_push" joint="hand_push" gear="800" ctrlrange="0 1"/>
  </actuator>
  <sensor>
    <actuatorfrc name="knee_torque" actuator="knee_target"/>
    <tendonlimitfrc name="rope_tension" tendon="rope"/>
    <actuatorfrc name="assist_force" actuator="assist_push"/>
    <jointpos name="unit_pitch" joint="root_pitch"/>
    <jointpos name="unit_z" joint="root_z"/>
  </sensor>
</mujoco>
