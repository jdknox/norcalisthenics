[Unit]
Description=Live Wii Balance Board dashboard
After=network.target pi_wiiboard_weight_logger.service
Wants=pi_wiiboard_weight_logger.service

[Service]
Type=simple
User=knox
ExecStart=/usr/bin/python3 -u /home/knox/.local/share/norcalisthenics/wii/pi_wiiboard_dashboard.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
