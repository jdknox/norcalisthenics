[Unit]
Description=Log Wii Balance Board weights from paired HID input
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=knox
ExecStart=/usr/bin/python3 -u /home/knox/.local/share/norcalisthenics/wii/pi_wiiboard_weight_logger.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
