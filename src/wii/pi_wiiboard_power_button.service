[Unit]
Description=Disconnect Wii Balance Board on front-button press
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=knox
ExecStart=/usr/bin/python3 -u /home/knox/.local/share/norcalisthenics/wii/pi_wiiboard_power_button.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
